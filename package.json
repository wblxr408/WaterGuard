{
  "name": "waterguard",
  "private": true,
  "workspaces": ["packages/contracts"],
  "scripts": {
    "start": "python scripts/start_agh.py",
    "start:api": "python scripts/start_workbench.py",
    "start:web": "pwsh -NoProfile -ExecutionPolicy Bypass -File apps/web-gpt/scripts/start-demo.ps1",
    "api:check": "python scripts/check_backend_api.py",
    "contracts:types": "npm run generate --workspace @waterguard/contracts",
    "contracts:types:check": "npm run check --workspace @waterguard/contracts",
    "contracts:check": "python packages/contracts/scripts/check.py",
    "test": "python -m unittest discover -s packages/contracts/tests -v",
    "demo": "python packages/contracts/scripts/demo.py",
    "mock": "python packages/contracts/scripts/mock_server.py",
    "hydraulics:check": "python -m services.hydraulics.datasets",
    "hydraulics:demo": "python -m services.hydraulics.demo",
    "hydraulics:serve": "python -m services.hydraulics.server",
    "hydraulics:test": "python -m unittest discover -s services/hydraulics/tests -v"
  }
}
